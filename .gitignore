```gitignore
# Compiled Python files
*.pyc
__pycache__/

# Logs
*.log

# Environment files
.env
.env.local
*.env.*

# Coverage reports
.coverage
coverage/
htmlcov/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# OS files
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
target/
*.out
*.exe
*.dll
*.so
*.a

# Dependencies
node_modules/
venv/
.venv/
.mypy_cache/
.pytest_cache/
.gradle/
```